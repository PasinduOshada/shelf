{
  "name": "shelf-desktop",
  "productName": "Shelf",
  "version": "0.1.0",
  "description": "Local-first tracker for the TV and movie library you already have on disk",
  "author": "Pasindu Oshada",
  "homepage": "https://github.com/PasinduOshada/shelf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PasinduOshada/shelf.git"
  },
  "bugs": {
    "url": "https://github.com/PasinduOshada/shelf/issues"
  },
  "keywords": [
    "tv-tracker",
    "media-library",
    "movie-tracker",
    "episode-tracker",
    "media-organizer",
    "file-renamer",
    "local-first",
    "offline",
    "electron",
    "tmdb",
    "self-hosted",
    "watchlist"
  ],
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "start": "npm run build:client && electron .",
    "dist": "npm run build:client && electron-builder && node scripts/checksums.cjs",
    "icon": "electron scripts/make-icon.cjs",
    "licenses": "node scripts/licenses.cjs",
    "checksums": "node scripts/checksums.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "multer": "^2.3.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "online.falconsl.shelf",
    "productName": "Shelf",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/icon.png",
      "licenses/**/*",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "server/src/**/*",
      "client/dist/**/*",
      "!server/data/**",
      "!**/node_modules/.cache/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.entertainment"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PasinduOshada",
        "repo": "shelf",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "**/node_modules/@ffprobe-installer/**"
    ]
  },
  "optionalDependencies": {
    "@ffprobe-installer/win32-x64": "^5.1.0"
  },
  "funding": {
    "type": "ko_fi",
    "url": "https://ko-fi.com/picklerobot"
  }
}
